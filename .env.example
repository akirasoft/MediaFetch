# ─────────────────────────────────────────────────────────────
# MediaFetch — ortam değişkenleri
# Kopyala:  cp .env.example .env    (sonra .env'i düzenle)
# Pterodactyl kullanıyorsan bunları panelin "Variables" sekmesine gir.
# ─────────────────────────────────────────────────────────────

# local  = masaüstü (127.0.0.1, tarayıcı otomatik açılır)
# server = sunucu  (0.0.0.0, tarayıcı açılmaz, dosyalar HTTP ile geri verilir)
MEDIAFETCH_MODE=server

# Dinlenecek port. Pterodactyl SERVER_PORT'u kendisi verdiği için panelde
# BOŞ BIRAK. Düz Ubuntu kurulumunda 8422 önerilir (yaygın portlarla çakışmaz).
MEDIAFETCH_PORT=8422

# Dinlenecek adres. Sunucuda 0.0.0.0 kalmalı.
MEDIAFETCH_HOST=0.0.0.0

# ZORUNLU (açık IP'de): erişim anahtarı. Boş bırakılırsa porta ulaşan herkes
# indirme yaptırabilir. Üretmek için:  openssl rand -hex 24
MEDIAFETCH_TOKEN=

# Tarayıcıda görünen adres (log ve yönlendirmelerde kullanılır).
# nginx arkasındaysan buraya dış adresi yaz.
MEDIAFETCH_PUBLIC_URL=http://ornek.duckdns.org:8422

# İndirilen dosyaların sunucudaki klasörü (boşsa ./downloads).
MEDIAFETCH_DOWNLOAD_DIR=

# Dosyalar kaç dakika sonra silinsin? 0 = hiç silme. Varsayılan 1440 (24 saat).
MEDIAFETCH_RETENTION_MIN=1440

# Web arayüzünü başka bir siteden gömeceksen o adresleri virgülle ekle.
# Chrome/Brave eklentileri zaten otomatik izinli.
MEDIAFETCH_ALLOWED_ORIGINS=

# ── Nadiren gerekenler ───────────────────────────────────────
# yt-dlp / ffmpeg yolunu elle vermek istersen:
# MEDIAFETCH_YTDLP=/usr/local/bin/yt-dlp
# MEDIAFETCH_FFMPEG=/usr/bin/ffmpeg
