# ─────────────────────────────────────────────────────────────
# MediaFetch — systemd servisi (Pterodactyl kullanmayan düz Ubuntu için)
#
#   sudo cp deploy/mediafetch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mediafetch
#   sudo journalctl -u mediafetch -f
#
# Yol ve kullanıcıyı kendi kurulumuna göre düzelt.
# ─────────────────────────────────────────────────────────────
[Unit]
Description=MediaFetch (yt-dlp web + extension server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediafetch
Group=mediafetch
WorkingDirectory=/opt/mediafetch
EnvironmentFile=-/opt/mediafetch/.env
Environment=MEDIAFETCH_MODE=server
ExecStart=/usr/bin/node /opt/mediafetch/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

# Uygulama yalnızca kendi klasörüne yazar.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mediafetch
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
