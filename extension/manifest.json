{
  "manifest_version": 3,
  "name": "MediaFetch",
  "version": "1.0.0",
  "description": "Download music & video from YouTube, TikTok, Instagram and 1000+ sites",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaFetch — music & video",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://localhost:3434/*",
    "http://127.0.0.1:3434/*"
  ]
}
